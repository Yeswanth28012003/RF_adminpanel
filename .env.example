# ============ Django Core ============

# SECURITY WARNING: keep the secret key used in production secret!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Always False in production
DEBUG=False

# Comma-separated hostnames, e.g.: admin.yourdomain.com
ALLOWED_HOSTS=admin.yourdomain.com,www.admin.yourdomain.com,localhost,127.0.0.1

# Your production domain (no protocol)
DOMAIN_NAME=admin.yourdomain.com

# Public site URL
SITE_URL=https://admin.yourdomain.com

# Comma-separated CSRF-trusted origins (must match SITE_URL)
CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com

# ============ CORS ============
# Comma-separated origins allowed to call the Admin API from the WebGL project
# e.g.: https://yourwebglproject.com,https://www.yourwebglproject.com
CORS_ALLOWED_ORIGINS=

# ============ Database (SQLite, persisted via Docker volume) ============
DB_NAME=data/db.sqlite3

# ============ Gunicorn ============
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# ============ Superuser (created automatically on first boot) ============
DJANGO_SUPERUSER_USERNAME=RF_admin
DJANGO_SUPERUSER_EMAIL=admin@rf.com
# SECURITY WARNING: change the password below!
DJANGO_SUPERUSER_PASSWORD=RF_3dwebgl26

# ============ SSL ============
# Email used for Let's Encrypt certificate notifications
SSL_EMAIL=admin@yourdomain.com

# ============ Ports ============
HTTP_PORT=80
HTTPS_PORT=443