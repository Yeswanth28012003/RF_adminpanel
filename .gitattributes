# Enforce LF for shell scripts (critical for Linux containers)
*.sh text eol=lf

# Python and config files
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.json text eol=lf

# Keep binary / images untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary